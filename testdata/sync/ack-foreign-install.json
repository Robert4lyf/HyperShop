{
  "name": "ack-foreign-install",
  "group": "acks",
  "description": "An ack for a seq this watch never issued (another install's ackedThrough, after the watch app was reinstalled) settles nothing; the watch says hello again and its op is still applied.",
  "steps": [
    {
      "do": "phone.add",
      "name": "Onion"
    },
    {
      "do": "watch.hello"
    },
    {
      "do": "settle"
    },
    {
      "do": "watch.toggle",
      "item": 1
    },
    {
      "do": "watch.send"
    },
    {
      "do": "phone.foreignAck",
      "at": 300
    },
    {
      "do": "deliverAll",
      "to": "watch"
    },
    {
      "expect": {
        "watch.outbox": 1,
        "watch.ackedThrough": 0,
        "watch.helloDue": true
      }
    },
    {
      "do": "settle"
    },
    {
      "expect": {
        "phone.ticks": 1,
        "watch.outbox": 0,
        "watch.ackedThrough": 1,
        "watch.view": { "1": true }
      }
    }
  ]
}
