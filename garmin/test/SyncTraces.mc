        ["recv", {"v" => 1, "t" => "snap", "ep" => 1, "lr" => 7, "at" => 0, "pg" => 0, "pgs" => 1, "ai" => [0, ["PRODUCE", "Produce", 0, false], ["DAIRY_EGGS", "Dairy & Eggs", 2, false]], "it" => [[3, "Garlic", "", 0, true, 2], [2, "Milk", "", 1, false, 1], [4, "Butter", "", 1, false, 1]], "mo" => 1}],
        ["state", {2 => false, 3 => true, 4 => false}, [], 0, 1, 1, 7, false, null, 0, {}],
        ["send", null],
        ["state", {2 => false, 3 => true, 4 => false}, [], 0, 1, 1, 7, false, null, 0, {}],
    ]);
}

(:test)
function traceSeqCollapseUnsent(logger as Test.Logger) as Lang.Boolean {
    return TraceReplay.run(logger, "seq-collapse-unsent", [
        ["config", 8, 32],
        ["hello", 0, 0, 0, 0],
        ["state", {}, [], 0, 1, 0, 0, false, null, 0, {}],
        ["send", null],
        ["state", {}, [], 0, 1, 0, 0, false, null, 0, {}],
        ["recv", {"v" => 1, "t" => "snap", "ep" => 1, "lr" => 3, "at" => 0, "pg" => 0, "pgs" => 1, "ai" => [0, ["PRODUCE", "Produce", 1, false], ["DAIRY_EGGS", "Dairy & Eggs", 1, false]], "it" => [[1, "Onion", "", 0, false, 1], [2, "Milk", "", 1, false, 1]]}],
        ["state", {1 => false, 2 => false}, [], 0, 1, 1, 3, true, null, 0, {}],
        ["hello", 0, 3, 0, 1],
        ["state", {1 => false, 2 => false}, [], 0, 1, 1, 3, false, null, 0, {}],
        ["send", null],
        ["state", {1 => false, 2 => false}, [], 0, 1, 1, 3, false, null, 0, {}],
        ["recv", {"v" => 1, "t" => "snap", "ep" => 1, "lr" => 3, "at" => 0, "pg" => 0, "pgs" => 1, "ai" => [0, ["PRODUCE", "Produce", 1, false], ["DAIRY_EGGS", "Dairy & Eggs", 1, false]], "it" => [[1, "Onion", "", 0, false, 1], [2, "Milk", "", 1, false, 1]]}],
        ["state", {1 => false, 2 => false}, [], 0, 1, 1, 3, false, null, 0, {}],
        ["send", null],
        ["state", {1 => false, 2 => false}, [], 0, 1, 1, 3, false, null, 0, {}],
        ["toggle", 1, 0, true],
        ["state", {1 => true, 2 => false}, [0], 0, 1, 1, 3, false, null, 0, {}],
        ["toggle", 1, 0, true],
        ["state", {1 => false, 2 => false}, [], 0, 1, 1, 3, false, null, 0, {}],
        ["toggle", 2, 0, true],
        ["state", {1 => false, 2 => true}, [0], 0, 1, 1, 3, false, null, 0, {}],
        ["toggle", 1, 0, true],
        ["state", {1 => true, 2 => true}, [0, 0], 0, 1, 1, 3, false, null, 0, {}],
        ["send", [[1, 2, true, 3, 0], [2, 1, true, 3, 0]]],
        ["state", {1 => true, 2 => true}, [1, 2], 0, 3, 1, 3, false, null, 0, {}],
        ["toggle", 2, 0, true],
        ["state", {1 => true, 2 => false}, [1, 2, 0], 0, 3, 1, 3, false, null, 0, {}],
        ["toggle", 2, 0, true],
        ["state", {1 => true, 2 => true}, [1, 2], 0, 3, 1, 3, false, null, 0, {}],
        ["send", null],
        ["state", {1 => true, 2 => true}, [1, 2], 0, 3, 1, 3, false, null, 0, {}],
        ["recv", {"v" => 1, "t" => "snap", "ep" => 1, "lr" => 5, "at" => 2, "pg" => 0, "pgs" => 1, "ai" => [0, ["PRODUCE", "Produce", 0, false], ["DAIRY_EGGS", "Dairy & Eggs", 0, false]], "it" => [[1, "Onion", "", 0, true, 2], [2, "Milk", "", 1, true, 2]]}],
        ["state", {1 => true, 2 => true}, [], 2, 3, 1, 5, false, null, 0, {1 => "ok", 2 => "ok"}],
        ["send", null],
        ["state", {1 => true, 2 => true}, [], 2, 3, 1, 5, false, null, 0, {1 => "ok", 2 => "ok"}],
    ]);
}

(:test)
function traceSeqGapAndReorder(logger as Test.Logger) as Lang.Boolean {
    return TraceReplay.run(logger, "seq-gap-and-reorder", [
        ["config", 8, 32],
        ["hello", 0, 0, 0, 0],
        ["state", {}, [], 0, 1, 0, 0, false, null, 0, {}],
        ["send", null],
        ["state", {}, [], 0, 1, 0, 0, false, null, 0, {}],
        ["recv", {"v" => 1, "t" => "snap", "ep" => 1, "lr" => 3, "at" => 0, "pg" => 0, "pgs" => 1, "ai" => [0, ["PRODUCE", "Produce", 1, false], ["DAIRY_EGGS", "Dairy & Eggs", 1, false]], "it" => [[1, "Onion", "", 0, false, 1], [2, "Milk", "", 1, false, 1]]}],
        ["state", {1 => false, 2 => false}, [], 0, 1, 1, 3, true, null, 0, {}],
        ["hello", 0, 3, 0, 1],
        ["state", {1 => false, 2 => false}, [], 0, 1, 1, 3, false, null, 0, {}],
        ["send", null],
        ["state", {1 => false, 2 => false}, [], 0, 1, 1, 3, false, null, 0, {}],
        ["recv", {"v" => 1, "t" => "snap", "ep" => 1, "lr" => 3, "at" => 0, "pg" => 0, "pgs" => 1, "ai" => [0, ["PRODUCE", "Produce", 1, false], ["DAIRY_EGGS", "Dairy & Eggs", 1, false]], "it" => [[1, "Onion", "", 0, false, 1], [2, "Milk", "", 1, false, 1]]}],
        ["state", {1 => false, 2 => false}, [], 0, 1, 1, 3, false, null, 0, {}],
        ["send", null],
        ["state", {1 => false, 2 => false}, [], 0, 1, 1, 3, false, null, 0, {}],
        ["recv", {"v" => 1, "t" => "snap", "ep" => 1, "lr" => 3, "at" => 0, "pg" => 0, "pgs" => 0, "it" => []}],
        ["state", {1 => false, 2 => false}, [], 0, 1, 1, 3, false, null, 0, {}],
        ["toggle", 1, 0, true],
        ["state", {1 => true, 2 => false}, [0], 0, 1, 1, 3, false, null, 0, {}],
        ["send", [[1, 1, true, 3, 0]]],
        ["state", {1 => true, 2 => false}, [1], 0, 2, 1, 3, false, null, 0, {}],
        ["toggle", 2, 0, true],
        ["state", {1 => true, 2 => true}, [1, 0], 0, 2, 1, 3, false, null, 0, {}],
        ["timeout"],
        ["state", {1 => true, 2 => true}, [1, 0], 0, 2, 1, 3, false, null, 0, {}],
        ["send", [[1, 1, true, 3, 0], [2, 2, true, 3, 0]]],
        ["state", {1 => true, 2 => true}, [1, 2], 0, 3, 1, 3, false, null, 0, {}],
        ["recv", {"v" => 1, "t" => "snap", "ep" => 1, "lr" => 5, "at" => 2, "pg" => 0, "pgs" => 1, "ai" => [0, ["PRODUCE", "Produce", 0, false], ["DAIRY_EGGS", "Dairy & Eggs", 0, false]], "it" => [[1, "Onion", "", 0, true, 2], [2, "Milk", "", 1, true, 2]]}],
        ["state", {1 => true, 2 => true}, [], 2, 3, 1, 5, false, null, 0, {1 => "ok", 2 => "ok"}],
        ["recv", {"v" => 1, "t" => "snap", "ep" => 1, "lr" => 5, "at" => 2, "pg" => 0, "pgs" => 0, "it" => []}],
        ["state", {1 => true, 2 => true}, [], 2, 3, 1, 5, false, null, 0, {1 => "ok", 2 => "ok"}],
        ["send", null],
        ["state", {1 => true, 2 => true}, [], 2, 3, 1, 5, false, null, 0, {1 => "ok", 2 => "ok"}],
    ]);
