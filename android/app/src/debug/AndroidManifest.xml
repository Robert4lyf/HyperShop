<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
      Settings › Voice test (the voice mode device spike): the microphone, a
      microphone foreground service so it keeps listening with the screen locked,
      its notification, and routing the mic to a headset. No Bluetooth permission:
      whether the headset mic works without one is one of the things it tests.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <application>
        <service
            android:name=".voice.VoiceTestService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

    </application>
</manifest>
